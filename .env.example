# Server-side only. Never prefix with VITE_ and never commit a real value.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Dev fixtures are only honoured when NODE_ENV is not "production". Keep 0 for any public deployment.
ALLOW_DEV_MODE=0
PORT=8787
NODE_ENV=production
# Optional: only used by POST /api/compare and the LLM brief parser. The app works fully without them.
ANTHROPIC_API_KEY=
LLM_MODEL=
